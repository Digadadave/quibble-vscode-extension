{
  "name": "quibble",
  "displayName": "Quibble",
  "description": "Review local git commits with GitHub-style comments. Agent-friendly metadata for Claude Code.",
  "version": "0.0.7",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "media/icon.png",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "quibble.copyAgentPrompt",
        "title": "Copy Agent Prompt",
        "icon": "$(copy)",
        "category": "Quibble"
      },
      {
        "command": "quibble.openQuibbles",
        "title": "Open Quibbles",
        "icon": "$(file-code)",
        "category": "Quibble"
      },
      {
        "command": "quibble.selectRepo",
        "title": "Select Repository",
        "icon": "$(repo)",
        "category": "Quibble"
      },
      {
        "command": "quibble.comment.reply",
        "title": "Submit Comment",
        "category": "Quibble"
      },
      {
        "command": "quibble.comment.resolve",
        "title": "Approve",
        "icon": "$(check-all)",
        "category": "Quibble"
      },
      {
        "command": "quibble.comment.gotoFile",
        "title": "Go to Source",
        "icon": "$(go-to-file)",
        "category": "Quibble"
      },
      {
        "command": "quibble.comment.dismiss",
        "title": "Dismiss",
        "icon": "$(sync-ignored)",
        "category": "Quibble"
      },
      {
        "command": "quibble.comment.cancelThread",
        "title": "Cancel",
        "category": "Quibble"
      },
      {
        "command": "quibble.comment.reopen",
        "title": "Reopen",
        "icon": "$(debug-restart)",
        "category": "Quibble"
      },
      {
        "command": "quibble.comment.delete",
        "title": "Delete Comment",
        "icon": "$(trash)",
        "category": "Quibble"
      },
      {
        "command": "quibble.comments.resolve",
        "title": "Approve",
        "icon": "$(check-all)",
        "category": "Quibble"
      },
      {
        "command": "quibble.comments.dismiss",
        "title": "Dismiss",
        "icon": "$(sync-ignored)",
        "category": "Quibble"
      },
      {
        "command": "quibble.comments.reopen",
        "title": "Reopen",
        "icon": "$(debug-restart)",
        "category": "Quibble"
      },
      {
        "command": "quibble.comments.delete",
        "title": "Delete",
        "icon": "$(trash)",
        "category": "Quibble"
      },
      {
        "command": "quibble.comments.openDiff",
        "title": "Open in Diff",
        "icon": "$(diff)",
        "category": "Quibble"
      },
      {
        "command": "quibble.changes.openAllChanges",
        "title": "Open All Changes",
        "icon": "$(diff-multiple)",
        "category": "Quibble"
      },
      {
        "command": "quibble.changes.toCommitsView",
        "title": "Switch to Commits View",
        "icon": "$(list-tree)",
        "category": "Quibble"
      },
      {
        "command": "quibble.changes.toFilesView",
        "title": "Switch to Files View",
        "icon": "$(three-bars)",
        "category": "Quibble"
      },
      {
        "command": "quibble.changes.collapseAll",
        "title": "Collapse All",
        "icon": "$(collapse-all)",
        "category": "Quibble"
      },
      {
        "command": "quibble.comments.showAll",
        "title": "Show All Comments",
        "icon": "$(eye-closed)",
        "category": "Quibble"
      },
      {
        "command": "quibble.comments.hideClosed",
        "title": "Hide Closed Comments",
        "icon": "$(eye)",
        "category": "Quibble"
      },
      {
        "command": "quibble.remapOrphans",
        "title": "Remap Orphaned Comments",
        "icon": "$(warning)",
        "category": "Quibble"
      },
      {
        "command": "quibble.dismissOrphans",
        "title": "Dismiss Orphaned Comments",
        "icon": "$(close)",
        "category": "Quibble"
      },
      {
        "command": "quibble.comments.viewFix",
        "title": "View Fix",
        "icon": "$(go-to-file)",
        "category": "Quibble"
      },
      {
        "command": "quibble.setBaseBranch",
        "title": "Set Base Branch",
        "category": "Quibble"
      },
      {
        "command": "quibble.repoMenu",
        "title": "Repository Settings",
        "icon": "$(repo)",
        "category": "Quibble"
      },
      {
        "command": "quibble.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Quibble"
      },
      {
        "command": "quibble.diagnostics",
        "title": "Show Diagnostics",
        "category": "Quibble"
      },
      {
        "command": "quibble.changes.showSearch",
        "title": "Search Files",
        "icon": "$(search)",
        "category": "Quibble"
      },
      {
        "command": "quibble.changes.hideSearch",
        "title": "Hide Search",
        "icon": "$(search-stop)",
        "category": "Quibble"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quibble",
          "title": "Quibble",
          "icon": "media/icon.min.svg"
        }
      ]
    },
    "views": {
      "quibble": [
        {
          "type": "tree",
          "id": "quibble.commentsView",
          "name": "Comments",
          "contextualTitle": "Quibble"
        },
        {
          "type": "webview",
          "id": "quibble.changesView",
          "name": "Changes",
          "contextualTitle": "Quibble"
        }
      ]
    },
    "configuration": {
      "title": "Quibble",
      "properties": {
        "quibble.reviewsPath": {
          "type": "string",
          "default": ".vscode/quibbles.json",
          "description": "Path (relative to the repo root) for the working comments JSON. This file is populated with comments for the current branch and is the file agents should read/write. The persistent DB lives in VS Code's globalStorage.",
          "scope": "resource"
        }
      }
    },
    "menus": {
      "commandPalette": [
        { "command": "quibble.comment.reply", "when": "false" },
        { "command": "quibble.comment.resolve", "when": "false" },
        { "command": "quibble.comment.gotoFile", "when": "false" },
        { "command": "quibble.comment.dismiss", "when": "false" },
        { "command": "quibble.comment.cancelThread", "when": "false" },
        { "command": "quibble.comment.reopen", "when": "false" },
        { "command": "quibble.comment.delete", "when": "false" },
        { "command": "quibble.comments.resolve", "when": "false" },
        { "command": "quibble.comments.dismiss", "when": "false" },
        { "command": "quibble.comments.reopen", "when": "false" },
        { "command": "quibble.comments.delete", "when": "false" },
        { "command": "quibble.comments.openDiff", "when": "false" },
        { "command": "quibble.comments.viewFix", "when": "false" },
        { "command": "quibble.comments.showAll", "when": "false" },
        { "command": "quibble.comments.hideClosed", "when": "false" },
        { "command": "quibble.changes.collapseAll", "when": "false" },
        { "command": "quibble.changes.toCommitsView", "when": "false" },
        { "command": "quibble.changes.toFilesView", "when": "false" },
        { "command": "quibble.changes.showSearch", "when": "false" },
        { "command": "quibble.changes.hideSearch", "when": "false" }
      ],
      "view/title": [
        {
          "command": "quibble.changes.toCommitsView",
          "when": "view == quibble.changesView && quibble.changesViewMode != 'commits'",
          "group": "navigation@3"
        },
        {
          "command": "quibble.changes.toFilesView",
          "when": "view == quibble.changesView && quibble.changesViewMode == 'commits'",
          "group": "navigation@3"
        },
        {
          "command": "quibble.changes.collapseAll",
          "when": "view == quibble.changesView",
          "group": "navigation@0"
        },
        {
          "command": "quibble.changes.showSearch",
          "when": "view == quibble.changesView && !quibble.changesSearchVisible",
          "group": "navigation@1"
        },
        {
          "command": "quibble.changes.hideSearch",
          "when": "view == quibble.changesView && quibble.changesSearchVisible",
          "group": "navigation@1"
        },
        {
          "command": "quibble.refresh",
          "when": "view == quibble.changesView",
          "group": "navigation@2"
        },
        {
          "command": "quibble.repoMenu",
          "when": "view == quibble.changesView",
          "group": "navigation@4"
        },
        {
          "command": "quibble.remapOrphans",
          "when": "view == quibble.commentsView && quibble.hasOrphans",
          "group": "navigation@0"
        },
        {
          "command": "quibble.comments.showAll",
          "when": "view == quibble.commentsView && !quibble.showClosed",
          "group": "navigation@1"
        },
        {
          "command": "quibble.comments.hideClosed",
          "when": "view == quibble.commentsView && quibble.showClosed",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "quibble.comments.resolve",
          "when": "view == quibble.commentsView && viewItem == comment-open",
          "group": "inline@1"
        },
        {
          "command": "quibble.comments.dismiss",
          "when": "view == quibble.commentsView && viewItem == comment-open",
          "group": "inline@2"
        },
        {
          "command": "quibble.comments.resolve",
          "when": "view == quibble.commentsView && viewItem == comment-addressed",
          "group": "inline@1"
        },
        {
          "command": "quibble.comments.dismiss",
          "when": "view == quibble.commentsView && viewItem == comment-addressed",
          "group": "inline@2"
        },
        {
          "command": "quibble.comments.reopen",
          "when": "view == quibble.commentsView && viewItem == comment-approved",
          "group": "inline@1"
        },
        {
          "command": "quibble.comments.delete",
          "when": "view == quibble.commentsView && (viewItem == comment-open || viewItem == comment-approved || viewItem == comment-addressed)",
          "group": "inline@3"
        },
        {
          "command": "quibble.comments.resolve",
          "when": "view == quibble.commentsView && viewItem == comment-open",
          "group": "1_status@1"
        },
        {
          "command": "quibble.comments.dismiss",
          "when": "view == quibble.commentsView && viewItem == comment-open",
          "group": "1_status@2"
        },
        {
          "command": "quibble.comments.resolve",
          "when": "view == quibble.commentsView && viewItem == comment-addressed",
          "group": "1_status@1"
        },
        {
          "command": "quibble.comments.dismiss",
          "when": "view == quibble.commentsView && viewItem == comment-addressed",
          "group": "1_status@2"
        },
        {
          "command": "quibble.comments.reopen",
          "when": "view == quibble.commentsView && viewItem == comment-approved",
          "group": "1_status@1"
        },
        {
          "command": "quibble.comments.delete",
          "when": "view == quibble.commentsView && (viewItem == comment-open || viewItem == comment-approved || viewItem == comment-addressed)",
          "group": "2_manage@1"
        },
        {
          "command": "quibble.comments.viewFix",
          "when": "view == quibble.commentsView && viewItem == resolvedNote-fix",
          "group": "inline@1"
        },
        {
          "command": "quibble.comments.viewFix",
          "when": "view == quibble.commentsView && viewItem == resolvedNote-fix",
          "group": "1_action@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "quibble.comment.cancelThread",
          "group": "inline@2",
          "when": "commentController == quibble && !(commentThread =~ /shadow/)"
        },
        {
          "command": "quibble.comment.reply",
          "group": "inline@1",
          "when": "commentController == quibble && !(commentThread =~ /shadow/)"
        },
        {
          "command": "quibble.comment.reopen",
          "group": "inline@3",
          "when": "commentController == quibble && commentThread =~ /status:(approved|dismissed|outdated)/"
        }
      ],
      "comments/comment/title": [],
      "comments/commentThread/title": [
        {
          "command": "quibble.comment.resolve",
          "group": "inline@1",
          "when": "commentController == quibble && commentThread =~ /status:(open|question|agent-replied|in-progress|needs-input|addressed)/"
        },
        {
          "command": "quibble.comment.dismiss",
          "group": "inline@2",
          "when": "commentController == quibble && commentThread =~ /status:(open|question|agent-replied|in-progress|needs-input|addressed)/"
        },
        {
          "command": "quibble.comment.gotoFile",
          "group": "inline@3",
          "when": "commentController == quibble"
        },
        {
          "command": "quibble.comment.reopen",
          "group": "inline@4",
          "when": "commentController == quibble && commentThread =~ /status:(approved|dismissed|outdated)/"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45"
  }
}
