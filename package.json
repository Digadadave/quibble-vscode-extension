{
  "name": "vscode-commit-review",
  "displayName": "Commit Review",
  "description": "Review local git commits with GitHub-style comments. Agent-friendly metadata for Claude Code.",
  "version": "0.0.3",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "media/icon.png",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commitReview.copyAgentPrompt",
        "title": "Copy Agent Prompt",
        "icon": "$(copy)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.selectRepo",
        "title": "Select Repository",
        "icon": "$(repo)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comment.reply",
        "title": "Submit Comment",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comment.resolve",
        "title": "Approve",
        "icon": "$(check-all)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comment.gotoFile",
        "title": "Go to Source",
        "icon": "$(go-to-file)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comment.dismiss",
        "title": "Dismiss",
        "icon": "$(circle-slash)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comment.cancelThread",
        "title": "Cancel",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comment.reopen",
        "title": "Reopen",
        "icon": "$(debug-restart)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comment.delete",
        "title": "Delete Comment",
        "icon": "$(trash)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comments.resolve",
        "title": "Approve",
        "icon": "$(check-all)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comments.dismiss",
        "title": "Dismiss",
        "icon": "$(sync-ignored)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comments.reopen",
        "title": "Reopen",
        "icon": "$(debug-restart)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comments.delete",
        "title": "Delete",
        "icon": "$(trash)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comments.openDiff",
        "title": "Open in Diff",
        "icon": "$(diff)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.changes.openAllChanges",
        "title": "Open All Changes",
        "icon": "$(diff-multiple)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.changes.toCommitsView",
        "title": "Switch to Commits View",
        "icon": "$(list-tree)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.changes.toFilesView",
        "title": "Switch to Files View",
        "icon": "$(three-bars)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.changes.collapseAll",
        "title": "Collapse All",
        "icon": "$(collapse-all)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comments.showAll",
        "title": "Show All Comments",
        "icon": "$(eye-closed)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comments.hideClosed",
        "title": "Hide Closed Comments",
        "icon": "$(eye)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.remapOrphans",
        "title": "Remap Orphaned Comments",
        "icon": "$(warning)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.dismissOrphans",
        "title": "Dismiss Orphaned Comments",
        "icon": "$(close)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comments.viewFix",
        "title": "View Fix",
        "icon": "$(go-to-file)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.setBaseBranch",
        "title": "Set Base Branch",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.repoMenu",
        "title": "Repository Settings",
        "icon": "$(repo)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.diagnostics",
        "title": "Show Diagnostics",
        "category": "Commit Review"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commitReview",
          "title": "Commit Review",
          "icon": "media/icon.min.svg"
        }
      ]
    },
    "views": {
      "commitReview": [
        {
          "type": "tree",
          "id": "commitReview.commentsView",
          "name": "Comments",
          "contextualTitle": "Commit Review"
        },
        {
          "type": "webview",
          "id": "commitReview.changesView",
          "name": "Changes",
          "contextualTitle": "Commit Review"
        }
      ]
    },
    "configuration": {
      "title": "Commit Review",
      "properties": {
        "commitReview.reviewsPath": {
          "type": "string",
          "default": ".vscode/commit-reviews.json",
          "description": "Path (relative to the repo root) for the working review JSON. This file is populated with comments for the current branch and is the file agents should read/write. The persistent DB lives in VS Code's globalStorage.",
          "scope": "resource"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "commitReview.changes.toCommitsView",
          "when": "view == commitReview.changesView && commitReview.changesViewMode != 'commits'",
          "group": "navigation@1"
        },
        {
          "command": "commitReview.changes.toFilesView",
          "when": "view == commitReview.changesView && commitReview.changesViewMode == 'commits'",
          "group": "navigation@1"
        },
        {
          "command": "commitReview.changes.collapseAll",
          "when": "view == commitReview.changesView",
          "group": "navigation@0"
        },
        {
          "command": "commitReview.repoMenu",
          "when": "view == commitReview.changesView",
          "group": "navigation@2"
        },
        {
          "command": "commitReview.remapOrphans",
          "when": "view == commitReview.commentsView && commitReview.hasOrphans",
          "group": "navigation@0"
        },
        {
          "command": "commitReview.comments.showAll",
          "when": "view == commitReview.commentsView && !commitReview.showClosed",
          "group": "navigation@1"
        },
        {
          "command": "commitReview.comments.hideClosed",
          "when": "view == commitReview.commentsView && commitReview.showClosed",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "commitReview.comments.resolve",
          "when": "view == commitReview.commentsView && viewItem == comment-open",
          "group": "inline@1"
        },
        {
          "command": "commitReview.comments.dismiss",
          "when": "view == commitReview.commentsView && viewItem == comment-open",
          "group": "inline@2"
        },
        {
          "command": "commitReview.comments.resolve",
          "when": "view == commitReview.commentsView && viewItem == comment-addressed",
          "group": "inline@1"
        },
        {
          "command": "commitReview.comments.dismiss",
          "when": "view == commitReview.commentsView && viewItem == comment-addressed",
          "group": "inline@2"
        },
        {
          "command": "commitReview.comments.reopen",
          "when": "view == commitReview.commentsView && viewItem == comment-approved",
          "group": "inline@1"
        },
        {
          "command": "commitReview.comments.delete",
          "when": "view == commitReview.commentsView && (viewItem == comment-open || viewItem == comment-approved || viewItem == comment-addressed)",
          "group": "inline@3"
        },
        {
          "command": "commitReview.comments.resolve",
          "when": "view == commitReview.commentsView && viewItem == comment-open",
          "group": "1_status@1"
        },
        {
          "command": "commitReview.comments.dismiss",
          "when": "view == commitReview.commentsView && viewItem == comment-open",
          "group": "1_status@2"
        },
        {
          "command": "commitReview.comments.resolve",
          "when": "view == commitReview.commentsView && viewItem == comment-addressed",
          "group": "1_status@1"
        },
        {
          "command": "commitReview.comments.dismiss",
          "when": "view == commitReview.commentsView && viewItem == comment-addressed",
          "group": "1_status@2"
        },
        {
          "command": "commitReview.comments.reopen",
          "when": "view == commitReview.commentsView && viewItem == comment-approved",
          "group": "1_status@1"
        },
        {
          "command": "commitReview.comments.delete",
          "when": "view == commitReview.commentsView && (viewItem == comment-open || viewItem == comment-approved || viewItem == comment-addressed)",
          "group": "2_manage@1"
        },
        {
          "command": "commitReview.comments.viewFix",
          "when": "view == commitReview.commentsView && viewItem == resolvedNote-fix",
          "group": "inline@1"
        },
        {
          "command": "commitReview.comments.viewFix",
          "when": "view == commitReview.commentsView && viewItem == resolvedNote-fix",
          "group": "1_action@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "commitReview.comment.cancelThread",
          "group": "inline@2",
          "when": "commentController == commit-review"
        },
        {
          "command": "commitReview.comment.reply",
          "group": "inline@1",
          "when": "commentController == commit-review"
        }
      ],
      "comments/comment/title": [],
      "comments/commentThread/title": [
        {
          "command": "commitReview.comment.resolve",
          "group": "inline@1",
          "when": "commentController == commit-review && commentThread =~ /status:(open|question|agent-replied|in-progress|needs-input)/"
        },
        {
          "command": "commitReview.comment.dismiss",
          "group": "inline@2",
          "when": "commentController == commit-review && commentThread =~ /status:(open|question|agent-replied|in-progress|needs-input|addressed|approved)/"
        },
        {
          "command": "commitReview.comment.gotoFile",
          "group": "inline@3",
          "when": "commentController == commit-review"
        },
        {
          "command": "commitReview.comment.reopen",
          "group": "inline@4",
          "when": "commentController == commit-review && commentThread =~ /status:(approved|dismissed|outdated)/"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45"
  }
}
