{
  "name": "vscode-commit-review",
  "displayName": "Commit Review",
  "description": "Review local git commits with GitHub-style comments. Agent-friendly metadata for Claude Code.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commitReview.openPanel",
        "title": "Open Commit Review Panel",
        "icon": "$(git-pull-request)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.copyAgentPrompt",
        "title": "Copy Agent Prompt",
        "icon": "$(copy)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.selectRepo",
        "title": "Select Repository",
        "icon": "$(repo)",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comment.reply",
        "title": "Submit Comment",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comment.setOpen",
        "title": "Set Open",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comment.setResolved",
        "title": "Set Resolved",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comment.setWontFix",
        "title": "Won't Fix",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comment.setPending",
        "title": "Set Pending",
        "category": "Commit Review"
      },
      {
        "command": "commitReview.comment.delete",
        "title": "Delete Comment",
        "icon": "$(trash)",
        "category": "Commit Review"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commitReview",
          "title": "Commit Review",
          "icon": "$(git-pull-request)"
        }
      ]
    },
    "views": {
      "commitReview": [
        {
          "type": "webview",
          "id": "commitReview.commentsView",
          "name": "Comments",
          "contextualTitle": "Commit Review"
        },
        {
          "type": "webview",
          "id": "commitReview.reviewView",
          "name": "Commits",
          "contextualTitle": "Commit Review"
        }
      ]
    },
    "configuration": {
      "title": "Commit Review",
      "properties": {
        "commitReview.reviewsPath": {
          "type": "string",
          "default": ".vscode/commit-reviews.json",
          "description": "Path relative to the repository root where review comments are stored.",
          "scope": "resource"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "commitReview.selectRepo",
          "when": "view == commitReview.reviewView",
          "group": "navigation"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "commitReview.comment.reply",
          "group": "inline",
          "when": "commentController == commit-review"
        }
      ],
      "comments/comment/title": [
        {
          "command": "commitReview.comment.delete",
          "group": "inline",
          "when": "commentController == commit-review"
        }
      ],
      "comments/comment/context": [
        {
          "command": "commitReview.comment.setOpen",
          "group": "status@1",
          "when": "commentController == commit-review"
        },
        {
          "command": "commitReview.comment.setResolved",
          "group": "status@2",
          "when": "commentController == commit-review"
        },
        {
          "command": "commitReview.comment.setWontFix",
          "group": "status@3",
          "when": "commentController == commit-review"
        },
        {
          "command": "commitReview.comment.setPending",
          "group": "status@4",
          "when": "commentController == commit-review"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
